PORT=4000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=parkpass-dev-secret-change-in-production

# PostgreSQL — раскомментируйте после: docker compose up -d
# DATABASE_URL=postgresql://parkpass:parkpass@127.0.0.1:5432/parkpass

# Без DATABASE_URL API работает в mock-режиме (in-memory)
# USE_MOCK=true

# Демо-аккаунты после npm run db:seed:
# demo@parkpass.ru / demo123       (user)
# admin@parkpass.ru / admin123     (admin)
# manager@parkpass.ru / manager123 (park_manager)
