{
  "name": "parkpass-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev",
    "dev:fast": "next dev",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev",
    "build": "node -e \"process.env.NEXT_BUILD='1';require('child_process').spawnSync('next',['build'],{stdio:'inherit',env:process.env,shell:true})\"",
    "start": "node -e \"process.env.NEXT_BUILD='1';require('child_process').spawnSync('next',['start'],{stdio:'inherit',env:process.env,shell:true})\"",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^14.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
